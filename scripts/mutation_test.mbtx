---
import {
  "moonbitlang/async",
  "moonbitlang/async/fs" @fs,
  "moonbitlang/async/process" @proc,
}
---

// agentskills.mbt 变异测试（运行：仓根 `moon run scripts/mutation_test.mbtx`）
// 对每个变异：生成变异源文件 → moon test → 判定 KILLED/SURVIVED → 恢复 → 汇总报告
// 纪律：每个变异点必须有杀手测试（新增覆盖 F01 validate 边界/F02 注册校验/差分层哨兵）。

///|
struct Mutation {
  id : String
  file : String
  old_sub : String
  new_sub : String
  desc : String
}

///|
let mutations : Array[Mutation] = [
  {
    id: "M01",
    file: "agentskills/skill/skill.mbt",
    old_sub: "m.name.length() > 64",
    new_sub: "m.name.length() > 64000",
    desc: "name length bound loosened 64->64000",
  },
  {
    id: "M02",
    file: "agentskills/skill/skill.mbt",
    old_sub: "if m.name.is_empty() {",
    new_sub: "if false {",
    desc: "name required guard disabled",
  },
  {
    id: "M03",
    file: "agentskills/skill/skill.mbt",
    old_sub: "} else if m.description.is_empty() {",
    new_sub: "} else if false {",
    desc: "description required guard disabled",
  },
  {
    id: "M04",
    file: "agentskills/skill/skill.mbt",
    old_sub: "m.description.length() > 1024",
    new_sub: "m.description.length() > 102400",
    desc: "description length bound loosened",
  },
  {
    id: "M05",
    file: "agentskills/skill/registry.mbt",
    old_sub: "if self.entries.contains(m.name) {",
    new_sub: "if false {",
    desc: "registry duplicate check disabled",
  },
  {
    id: "M06",
    file: "agentskills/skill/registry.mbt",
    old_sub: "Err(e) => return Err(e)",
    new_sub: "Err(_e) => ()",
    desc: "registry validate-first dropped",
  },
  {
    id: "M07",
    file: "agentskills/skill/frontmatter.mbt",
    old_sub: "lines[0].trim() != \"---\"",
    new_sub: "lines[0].trim() == \"---\"",
    desc: "frontmatter first-line check negated",
  },
  {
    id: "M08",
    file: "agentskills/skill/frontmatter.mbt",
    old_sub: "if lines[i].trim() == \"---\" {",
    new_sub: "if lines[i].trim() != \"---\" {",
    desc: "frontmatter closing check negated",
  },
  {
    id: "M09",
    file: "agentskills/skill/frontmatter.mbt",
    old_sub: "String(s) => Ok(Some([s]))",
    new_sub: "String(_s) => Ok(Some([]))",
    desc: "compatibility string branch drops value",
  },
  {
    id: "M10",
    file: "agentskills/skill/frontmatter.mbt",
    old_sub: "m[k2] = v2",
    new_sub: "()",
    desc: "metadata entry dropped",
  },
  {
    id: "M11",
    file: "agentskills/skill/frontmatter.mbt",
    old_sub: "body_parts.push(lines[i])",
    new_sub: "body_parts.push(\"\")",
    desc: "skill body lost",
  },
  {
    id: "M12",
    file: "verify/verify/known_failure.mbt",
    old_sub: "if f == id {",
    new_sub: "if f != id {",
    desc: "guard_known membership negated",
  },
  {
    id: "M13",
    file: "verify/verify/known_failure.mbt",
    old_sub: "\"UP-019\",",
    new_sub: "\"UP-999\",",
    desc: "known_failure registry entry corrupted (quarantine lost)",
  },
  {
    id: "M14",
    file: "agentskills/skill/frontmatter.mbt",
    old_sub: "_ => Err(\"frontmatter must be a YAML mapping\")",
    new_sub: "_ => Ok(Map::from_array([]))",
    desc: "non-mapping frontmatter accepted",
  },
  {
    id: "M15",
    file: "agentskills/rbac/rbac.mbt",
    old_sub: "max_sensitivity(role).rank() >= sensitivity.rank()",
    new_sub: "max_sensitivity(role).rank() > sensitivity.rank()",
    desc: "RBAC authorization boundary loosened (>= to >)",
  },
  {
    id: "M16",
    file: "agentskills/rbac/rbac.mbt",
    old_sub: "Operator => Internal",
    new_sub: "Operator => Public",
    desc: "Operator role downgraded to Public",
  },
  {
    id: "M17",
    file: "agentskills/auth/password.mbt",
    old_sub: "@xbcrypt.verify(password=@utf8.encode(password), hashed~)",
    new_sub: "true",
    desc: "password verification always accepts",
  },
  {
    id: "M18",
    file: "agentskills/auth/jwt.mbt",
    old_sub: "@jwt.sign(claims, @jwt.Alg::of(\"HS256\"), signer)",
    new_sub: "@jwt.sign(Map::from_array([]), @jwt.Alg::of(\"HS256\"), signer)",
    desc: "JWT claims dropped at signing",
  },
  {
    id: "M19",
    file: "agentskills/compactor/compactor.mbt",
    old_sub: "let dropped = if total > keep { total - keep } else { 0 }",
    new_sub: "let dropped = total",
    desc: "compactor placeholder count inflated",
  },
  {
    id: "M20",
    file: "agentskills/compactor/compactor.mbt",
    old_sub: "if n >= max_chars {",
    new_sub: "if n > max_chars {",
    desc: "unicode truncation off-by-one (splits one extra char)",
  },
  {
    id: "M21",
    file: "agentskills/storage/storage.mbt",
    old_sub: "self.map[key] = value",
    new_sub: "()",
    desc: "storage put no-op",
  },
  {
    id: "M22",
    file: "agentskills/storage/storage.mbt",
    old_sub: "if self.map.contains(key) {",
    new_sub: "if true {",
    desc: "storage delete always reports true",
  },
  {
    id: "M23",
    file: "agentskills/rag/rag.mbt",
    old_sub: "let add = 1.0 / (k.to_double() + rank)",
    new_sub: "let add = k.to_double() + rank",
    desc: "RRF reciprocal ranking inverted (no reciprocal)",
  },
  {
    id: "M24",
    file: "agentskills/rag/rag.mbt",
    old_sub: "self.engine.add_document(doc_id, text)",
    new_sub: "()",
    desc: "rag index add no-op",
  },
  {
    id: "M25",
    file: "agentskills/skill/skill.mbt",
    old_sub: "self.license is Some(_)",
    new_sub: "self.license is None",
    desc: "has_license predicate inverted",
  },
  {
    id: "M26",
    file: "agentskills/skill/registry.mbt",
    old_sub: "self.entries[name] = (pair.0, FullyLoaded)",
    new_sub: "self.entries[name] = (pair.0, Metadata)",
    desc: "promote keeps Metadata level",
  },
  {
    id: "M27",
    file: "agentskills/rbac/rbac.mbt",
    old_sub: "Internal => \"internal\"",
    new_sub: "Internal => \"int\"",
    desc: "sensitivity label mutated",
  },
  {
    id: "M28",
    file: "agentskills/compactor/compactor.mbt",
    old_sub: "n = n + count_chars(m.content)",
    new_sub: "n = n + count_chars(m.content) + 1",
    desc: "total_chars off-by-one",
  },
  {
    id: "M29",
    file: "agentskills/rag/rag.mbt",
    old_sub: "let limit = if all.length() < top_n { all.length() } else { top_n }",
    new_sub: "let limit = all.length()",
    desc: "rrf_fuse_top ignores top_n bound",
  },
  {
    id: "M30",
    file: "agentskills/tooling_bridge/adapter.mbt",
    old_sub: "to_descriptor(t).to_mcp_entry()",
    new_sub: "to_descriptor(t).to_json()",
    desc: "MCP entry replaced by wire json view",
  },
]

///|
fn replace_all(s : String, old : String, new : String) -> String {
  let parts = s.split(old)
  if parts.length() == 1 {
    return s
  }
  let buf = StringBuilder()
  for i, p in parts {
    buf.write_string(p.to_string())
    if i < parts.length() - 1 {
      buf.write_string(new)
    }
  }
  buf.to_string()
}

///|
async fn run_tests() -> Int {
  let (code, _out, _err) = @proc.collect_output("moon", ["test"], cwd=".") catch {
    _ => panic()
  }
  code
}

///|
async fn main raise {
  let files = [
    "agentskills/skill/skill.mbt",
    "agentskills/skill/registry.mbt",
    "agentskills/skill/frontmatter.mbt",
    "agentskills/rag/rag.mbt",
    "agentskills/rbac/rbac.mbt",
    "agentskills/auth/password.mbt",
    "agentskills/auth/jwt.mbt",
    "agentskills/compactor/compactor.mbt",
    "agentskills/storage/storage.mbt",
    "agentskills/tooling_bridge/adapter.mbt",
    "verify/verify/known_failure.mbt",
    "verify/verify/fixture_test.mbt",
  ]
  let sources : Map[String, String] = Map([])
  for f in files {
    let content = @fs.read_file(f).text() catch { _ => panic() }
    sources[f] = content
  }
  let mut killed = 0
  let mut survived = 0
  let results : Array[String] = []
  for m in mutations {
    let original = sources.get(m.file).unwrap_or("")
    let mutated = replace_all(original, m.old_sub, m.new_sub)
    if mutated == original {
      results.push("\{m.id}: NOT-APPLIED (pattern not found: \{m.old_sub})")
      continue
    }
    @fs.write_file(m.file, mutated)
    let code = run_tests()
    if code == 0 {
      survived += 1
      results.push("\{m.id}: SURVIVED — \{m.desc}")
    } else {
      killed += 1
      results.push("\{m.id}: KILLED — \{m.desc}")
    }
    @fs.write_file(m.file, original)
  }
  let final_code = run_tests()
  for r in results {
    println(r)
  }
  println("=== mutation summary ===")
  println("killed=\{killed} survived=\{survived} total=\{mutations.length()}")
  if final_code == 0 {
    println("baseline restored: tests green")
  } else {
    println("WARNING: baseline tests failing after restore — manual check needed")
  }
}