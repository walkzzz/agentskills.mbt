---
import {
  "moonbitlang/async",
  "moonbitlang/async/fs" @fs,
  "moonbitlang/async/process" @proc,
}
---

// agentskills.mbt 变异测试（运行：仓根 `moon run scripts/mutation_test.mbtx`）
// 对每个变异：生成变异源文件 → moon test → 判定 KILLED/SURVIVED → 恢复 → 汇总报告
// 纪律：每个变异点必须有杀手测试（新增覆盖 F01 validate 边界/F02 注册校验/差分层哨兵）。

///|
struct Mutation {
  id : String
  file : String
  old_sub : String
  new_sub : String
  desc : String
}

///|
let mutations : Array[Mutation] = [
  {
    id: "M01",
    file: "agentskills/skill/skill.mbt",
    old_sub: "m.name.length() > 64",
    new_sub: "m.name.length() > 64000",
    desc: "name length bound loosened 64->64000",
  },
  {
    id: "M02",
    file: "agentskills/skill/skill.mbt",
    old_sub: "if m.name.is_empty() {",
    new_sub: "if false {",
    desc: "name required guard disabled",
  },
  {
    id: "M03",
    file: "agentskills/skill/skill.mbt",
    old_sub: "} else if m.description.is_empty() {",
    new_sub: "} else if false {",
    desc: "description required guard disabled",
  },
  {
    id: "M04",
    file: "agentskills/skill/skill.mbt",
    old_sub: "m.description.length() > 1024",
    new_sub: "m.description.length() > 102400",
    desc: "description length bound loosened",
  },
  {
    id: "M05",
    file: "agentskills/skill/registry.mbt",
    old_sub: "if self.entries.contains(m.name) {",
    new_sub: "if false {",
    desc: "registry duplicate check disabled",
  },
  {
    id: "M06",
    file: "agentskills/skill/registry.mbt",
    old_sub: "Err(e) => return Err(e)",
    new_sub: "Err(_e) => ()",
    desc: "registry validate-first dropped",
  },
  {
    id: "M07",
    file: "agentskills/skill/frontmatter.mbt",
    old_sub: "lines[0].trim() != \"---\"",
    new_sub: "lines[0].trim() == \"---\"",
    desc: "frontmatter first-line check negated",
  },
  {
    id: "M08",
    file: "agentskills/skill/frontmatter.mbt",
    old_sub: "if lines[i].trim() == \"---\" {",
    new_sub: "if lines[i].trim() != \"---\" {",
    desc: "frontmatter closing check negated",
  },
  {
    id: "M09",
    file: "agentskills/skill/frontmatter.mbt",
    old_sub: "String(s) => compatibility = Some([s])",
    new_sub: "String(_s) => compatibility = Some([])",
    desc: "compatibility string branch drops value",
  },
  {
    id: "M10",
    file: "agentskills/skill/frontmatter.mbt",
    old_sub: "m[k2] = v2",
    new_sub: "()",
    desc: "metadata entry dropped",
  },
  {
    id: "M11",
    file: "agentskills/skill/frontmatter.mbt",
    old_sub: "body_parts.push(lines[i].to_string())",
    new_sub: "body_parts.push(\"\")",
    desc: "skill body lost",
  },
  {
    id: "M12",
    file: "verify/verify/known_failure.mbt",
    old_sub: "if f == id {",
    new_sub: "if f != id {",
    desc: "guard_known membership negated",
  },
  {
    id: "M13",
    file: "verify/verify/known_failure.mbt",
    old_sub: "\"UP-019\",",
    new_sub: "\"UP-999\",",
    desc: "known_failure registry entry corrupted (quarantine lost)",
  },
  {
    id: "M14",
    file: "agentskills/skill/frontmatter.mbt",
    old_sub: "          _ => ()\n        }",
    new_sub: "          _ => return Err(\"unknown field\")\n        }",
    desc: "unknown frontmatter field rejected",
  },
]

///|
fn replace_all(s : String, old : String, new : String) -> String {
  let parts = s.split(old)
  if parts.length() == 1 {
    return s
  }
  let buf = StringBuilder()
  for i, p in parts {
    buf.write_string(p.to_string())
    if i < parts.length() - 1 {
      buf.write_string(new)
    }
  }
  buf.to_string()
}

///|
async fn run_tests() -> Int {
  let (code, _out, _err) = @proc.collect_output("moon", ["test"], cwd=".") catch {
    _ => panic()
  }
  code
}

///|
async fn main raise {
  let files = [
    "agentskills/skill/skill.mbt",
    "agentskills/skill/registry.mbt",
    "agentskills/skill/frontmatter.mbt",
    "verify/verify/known_failure.mbt",
    "verify/verify/fixture_test.mbt",
  ]
  let sources : Map[String, String] = Map([])
  for f in files {
    let content = @fs.read_file(f).text() catch { _ => panic() }
    sources[f] = content
  }
  let mut killed = 0
  let mut survived = 0
  let results : Array[String] = []
  for m in mutations {
    let original = sources.get(m.file).unwrap_or("")
    let mutated = replace_all(original, m.old_sub, m.new_sub)
    if mutated == original {
      results.push("\{m.id}: NOT-APPLIED (pattern not found: \{m.old_sub})")
      continue
    }
    @fs.write_file(m.file, mutated)
    let code = run_tests()
    if code == 0 {
      survived += 1
      results.push("\{m.id}: SURVIVED — \{m.desc}")
    } else {
      killed += 1
      results.push("\{m.id}: KILLED — \{m.desc}")
    }
    @fs.write_file(m.file, original)
  }
  let final_code = run_tests()
  for r in results {
    println(r)
  }
  println("=== mutation summary ===")
  println("killed=\{killed} survived=\{survived} total=\{mutations.length()}")
  if final_code == 0 {
    println("baseline restored: tests green")
  } else {
    println("WARNING: baseline tests failing after restore — manual check needed")
  }
}